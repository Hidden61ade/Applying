---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

const coverProjects = projects.filter((p) => p.data.cover);
const featuredProject = coverProjects.find((p) => p.data.depth === "deep") ?? coverProjects[0];

const tints = [
  "#1a1714",
  "#1c1a16",
  "#1a1815",
  "#1e1b17",
  "#1b1916",
  "#1d1b17",
  "#1c1a15",
];

const roleFilters = [
  { label: "All work", role: "" },
  { label: "Design", role: "designer" },
  { label: "Programming", role: "programmer" },
  { label: "Writing", role: "writer" },
  { label: "Interaction", role: "interaction" },
] as const;

type Lineage = "joy" | "mechanic" | "boundary";
const lineageMap: Record<string, Lineage> = {
  "heart-keys": "joy",
  "devil-cops-androids": "joy",
  "space-bar-porter": "joy",
  "right-click-to-activate-translator": "mechanic",
  "the-birthday-party": "mechanic",
  "hashmon": "boundary",
  "gugugaga-penguin": "boundary",
};

const lineages: { id: Lineage; title: string; caption: string }[] = [
  { id: "joy", title: "The Joy of Play", caption: "01 — where it begins" },
  { id: "mechanic", title: "Mechanic as Narrative", caption: "02 — where the system speaks" },
  { id: "boundary", title: "The Boundaries of a Game", caption: "03 — where the form bends" },
];

const projectsByLineage: Record<Lineage, typeof projects> = {
  joy: [],
  mechanic: [],
  boundary: [],
};
for (const p of projects) {
  const l = lineageMap[p.id];
  if (l) projectsByLineage[l].push(p);
}
---

<BaseLayout>
  <section class="home-hero container-wide">
    <div class="home-hero__copy">
      <p class="eyebrow">Baohua (Arno) Fang · CUHK-Shenzhen</p>
      <h1 class="home-hero__title">
        To broaden the boundaries of what a <em>story</em> can be.
      </h1>
      <p class="home-hero__lede">
        Game designer and creative technologist working across systemic narrative,
        interaction prototyping, and engineering.
      </p>
      <div class="home-hero__actions">
        <a class="button-primary" href="#selected-work">Explore selected work <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="/about">More about me <span aria-hidden="true">→</span></a>
      </div>
      <dl class="home-hero__focus" aria-label="Areas of focus">
        <div><dt>01</dt><dd>Systemic narrative</dd></div>
        <div><dt>02</dt><dd>Interaction prototypes</dd></div>
        <div><dt>03</dt><dd>Creative engineering</dd></div>
      </dl>
    </div>

    {featuredProject && (
      <a
        class="home-featured group"
        href={featuredProject.data.depth === "deep" ? `/projects/${featuredProject.id}` : "/projects"}
        aria-label={`View featured project: ${featuredProject.data.title}`}
      >
        <div class="home-featured__image">
          <img
            src={featuredProject.data.cover}
            alt={`Cover art for ${featuredProject.data.title}`}
            style={`object-position: ${featuredProject.data.coverPosition ?? "center"}`}
          />
        </div>
        <div class="home-featured__caption">
          <span><small>Featured case study</small>{featuredProject.data.title}</span>
          <span class="home-featured__arrow" aria-hidden="true">↗</span>
        </div>
      </a>
    )}
  </section>

  <section id="selected-work" class="selected-work container-wide">
    <header class="selected-work__header">
      <div>
        <p class="eyebrow">Selected work · {projects.length} projects</p>
        <h2>Ideas made playable.</h2>
      </div>
      <p>
        A project-first view of my design practice, grouped by the question each
        body of work explores.
      </p>
    </header>

    <div class="role-tabs-bar" role="group" aria-label="Filter projects by contribution">
      {roleFilters.map(({ label, role }) => (
        <button
          class:list={["role-tab", { active: role === "" }]}
          data-role={role}
          type="button"
          aria-pressed={role === "" ? "true" : "false"}
        >
          {label}
        </button>
      ))}
    </div>

    <div id="lineage-stack">
      {lineages.map((lin) => {
        const items = projectsByLineage[lin.id];
        if (!items.length) return null;
        return (
          <section class="lineage-section" data-lineage={lin.id}>
            <header class="lineage-header">
              <p class="lineage-caption">{lin.caption}</p>
              <h2 class="lineage-title">{lin.title}</h2>
            </header>
            <div class="home-project-grid">
              {items.map((p, i) => {
                const href = p.data.depth === "deep" ? `/projects/${p.id}` : "/projects";
                const tint = tints[i % tints.length];
                const roles = p.data.tags.map((tag) => tag.toLowerCase());
                return (
                  <a
                    href={href}
                    class="group block card-reveal project-card"
                    data-roles={roles.join(" ")}
                    style={`transition-delay: ${(i % 3) * 80}ms; view-transition-name: card-${p.id};`}
                  >
                    <div class="project-card__media" style={`background-color: ${tint}`}>
                      {p.data.cover ? (
                        <img
                          src={p.data.cover}
                          alt={`Cover art for ${p.data.title}`}
                          style={`object-position: ${p.data.coverPosition ?? "center"}`}
                          transition:name={`cover-${p.id}`}
                        />
                      ) : (
                        <span class="text-[color:var(--color-ink)]/30 text-xs tracking-[0.2em] uppercase flex items-end h-full p-4">
                          {p.data.year}
                        </span>
                      )}
                    </div>
                    <div class="project-card__body">
                      <div class="project-card__meta">
                        <p>{p.data.year} · {p.data.role.split(" / ")[0]}</p>
                        <span>{p.data.depth === "deep" ? "Case study" : "Quick view"}</span>
                      </div>
                      <div class="project-card__title-row">
                        <h3 transition:name={`title-${p.id}`}>
                          {p.data.title}
                        </h3>
                        <span aria-hidden="true">→</span>
                      </div>
                      {(p.data.hook || p.data.summary) && (
                        <p class="project-card__summary">
                          {p.data.hook ?? p.data.summary}
                        </p>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    min-height: min(860px, calc(100vh - 1rem));
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    padding-top: clamp(3rem, 7vh, 6.5rem);
    padding-bottom: clamp(4rem, 9vh, 7rem);
  }
  .home-hero__copy {
    max-width: 47rem;
  }
  .home-hero__title {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 6.5vw, 7rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .home-hero__title em {
    color: var(--color-accent);
    font-weight: inherit;
  }
  .home-hero__lede {
    max-width: 38rem;
    margin-top: 2rem;
    color: var(--color-ink-dim);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.65;
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }
  .home-hero__focus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: clamp(3rem, 8vh, 5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }
  .home-hero__focus div {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
  }
  .home-hero__focus dt {
    color: var(--color-accent);
    font: 500 0.62rem/1 var(--font-mono);
    letter-spacing: 0.12em;
  }
  .home-hero__focus dd {
    color: var(--color-ink-dim);
    font-size: 0.75rem;
    line-height: 1.35;
  }
  .home-featured {
    display: block;
    align-self: center;
  }
  .home-featured__image {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-bg-2);
  }
  .home-featured__image::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    pointer-events: none;
  }
  .home-featured__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.04);
    transition: transform 550ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 300ms ease;
  }
  .home-featured:hover img {
    transform: scale(1.025);
    filter: saturate(1) contrast(1.04);
  }
  .home-featured__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  .home-featured__caption small {
    display: block;
    margin-bottom: 0.1rem;
    color: var(--color-ink-dim);
    font: 500 0.62rem/1.5 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .home-featured__arrow {
    color: var(--color-accent);
    transition: transform 200ms ease;
  }
  .home-featured:hover .home-featured__arrow {
    transform: translate(0.2rem, -0.2rem);
  }

  .selected-work {
    padding-top: clamp(4rem, 9vw, 8rem);
    padding-bottom: 6rem;
    border-top: 1px solid var(--color-rule);
    scroll-margin-top: 7rem;
  }
  .selected-work__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 3rem;
  }
  .selected-work__header h2 {
    margin-top: 0.75rem;
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 400;
    line-height: 1;
  }
  .selected-work__header > p {
    max-width: 36rem;
    color: var(--color-ink-dim);
    line-height: 1.65;
  }

  .role-tabs-bar {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 4rem;
    gap: 0;
  }
  .role-tab {
    min-height: 44px;
    padding: 0.65rem clamp(0.75rem, 2vw, 1.25rem);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: none;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }
  .role-tab:hover {
    color: var(--color-ink);
  }
  .role-tab.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* ── Lineage section headings ── */
  .lineage-section {
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }
  .lineage-section:last-child {
    margin-bottom: 0;
  }
  .lineage-header {
    margin-bottom: 1.75rem;
    display: grid;
    grid-template-columns: minmax(9rem, 0.45fr) 1fr;
    align-items: end;
    gap: 1.5rem;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 0.6rem;
  }
  .lineage-caption {
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
    white-space: nowrap;
  }
  .lineage-title {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.8vw, 2.4rem);
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.2;
  }
  .home-project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
  }
  .project-card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 300ms ease;
  }
  .project-card:hover .project-card__media img {
    transform: scale(1.035);
    filter: saturate(1.08);
  }
  .project-card__body {
    padding-top: 0.9rem;
  }
  .project-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-ink-dim);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .project-card__meta span {
    color: var(--color-accent-2);
    white-space: nowrap;
  }
  .project-card__title-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
    margin-top: 0.55rem;
  }
  .project-card__title-row h3 {
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    font-weight: 400;
    line-height: 1.16;
    transition: color 200ms ease;
  }
  .project-card__title-row span {
    color: var(--color-accent);
    transition: transform 200ms ease;
  }
  .project-card:hover .project-card__title-row h3 {
    color: var(--color-accent);
  }
  .project-card:hover .project-card__title-row span {
    transform: translateX(0.25rem);
  }
  .project-card__summary {
    display: -webkit-box;
    margin-top: 0.65rem;
    overflow: hidden;
    color: var(--color-ink-dim);
    font-size: 0.82rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* ── Filter: hide non-matching cards ── */
  #lineage-stack[data-filter="designer"] .project-card:not([data-roles~="designer"]),
  #lineage-stack[data-filter="programmer"] .project-card:not([data-roles~="programmer"]),
  #lineage-stack[data-filter="writer"] .project-card:not([data-roles~="writer"]),
  #lineage-stack[data-filter="interaction"] .project-card:not([data-roles~="interaction"]) {
    display: none;
  }
  /* Collapse a lineage section if it has zero matching cards */
  #lineage-stack[data-filter="designer"] .lineage-section:not(:has(.project-card[data-roles~="designer"])),
  #lineage-stack[data-filter="programmer"] .lineage-section:not(:has(.project-card[data-roles~="programmer"])),
  #lineage-stack[data-filter="writer"] .lineage-section:not(:has(.project-card[data-roles~="writer"])),
  #lineage-stack[data-filter="interaction"] .lineage-section:not(:has(.project-card[data-roles~="interaction"])) {
    display: none;
  }

  .card-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .card-reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  @media (max-width: 1180px) {
    .home-hero {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 3rem;
    }
    .selected-work__header {
      grid-template-columns: 1fr;
    }
    .home-featured {
      width: min(100%, 38rem);
    }
    .home-featured__image {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 640px) {
    .home-hero {
      padding-top: 3.5rem;
      padding-bottom: 4rem;
    }
    .home-hero__title {
      font-size: clamp(3rem, 14vw, 4.3rem);
    }
    .home-hero__focus {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
    .lineage-header {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .role-tabs-bar {
      flex-wrap: nowrap;
      margin-inline: -1.5rem;
      padding-inline: 1.5rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .role-tabs-bar::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script is:inline>
  function initScrollReveal() {
    var cards = document.querySelectorAll('.card-reveal');
    if (!cards.length) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('revealed');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    cards.forEach(function (c) { io.observe(c); });
  }

  document.addEventListener('astro:page-load', function () {
    initScrollReveal();
  });
</script>

<script>
  // Astro-processed script: TypeScript, bundled, deduped
  function initRoleTabs(): void {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.role-tab');
    const stack = document.getElementById('lineage-stack');
    if (!stack || !tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const role = tab.dataset.role ?? '';

        // Update pressed state + active class
        tabs.forEach((t) => {
          t.classList.toggle('active', t === tab);
          t.setAttribute('aria-pressed', t === tab ? 'true' : 'false');
        });

        // Animate with View Transitions API if available
        if ('startViewTransition' in document) {
          document.startViewTransition(() => { stack.dataset.filter = role; });
        } else {
          stack.dataset.filter = role;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initRoleTabs);
</script>
