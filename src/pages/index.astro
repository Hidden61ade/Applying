---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout>
  <!-- Hero -->
  <section class="container-wide pt-24 pb-32">
    <p class="eyebrow mb-6">Baohua (Arno) Fang · CUHK-Shenzhen</p>
    <h1 class="display-xl max-w-[14ch]">
      Expanding the <em class="text-[color:var(--color-accent)] not-italic">boundaries</em> of interactive storytelling.
    </h1>
    <p class="mt-10 max-w-2xl text-lg text-[color:var(--color-ink-dim)] leading-relaxed">
      I started as a writer. I now design systems that let players co-author the stories I once tried to tell alone.
      Game design, narrative architecture, and human-computer interaction — in that exact order of motive.
    </p>
    <div class="flex gap-4 mt-10">
      <a
        href="/projects"
        class="px-5 py-3 rounded-full bg-[color:var(--color-ink)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-accent)] transition-colors"
      >
        See the work →
      </a>
      <a
        href="/about"
        class="px-5 py-3 rounded-full border border-[color:var(--color-rule)] hover:border-[color:var(--color-ink-dim)] transition-colors"
      >
        About me
      </a>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="container-wide pb-24">
    <div class="flex items-end justify-between mb-10">
      <h2 class="display-lg">Selected Work</h2>
      <a
        href="/projects"
        class="text-[color:var(--color-ink-dim)] hover:text-[color:var(--color-ink)]"
      >
        All projects →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((p) => (
        <a
          href={p.data.depth === "deep" ? `/projects/${p.id}` : "/projects"}
          class="group block p-8 rounded-2xl border border-[color:var(--color-rule)] hover:border-[color:var(--color-ink-dim)] transition-colors bg-[color:var(--color-bg-2)]"
        >
          <p class="eyebrow">{p.data.year} · {p.data.role}</p>
          <h3 class="text-3xl font-[var(--font-display)] mt-3 group-hover:text-[color:var(--color-accent)] transition-colors">
            {p.data.title}
          </h3>
          {p.data.hook && (
            <p class="mt-4 italic leading-snug">“{p.data.hook}”</p>
          )}
          {p.data.award && (
            <p class="text-xs text-[color:var(--color-accent-2)] mt-4">{p.data.award}</p>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
