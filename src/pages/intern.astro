---
import BaseLayout from "../layouts/BaseLayout.astro";

const internships = [
  {
    company: "Lilith Games — Avatar Technology",
    role: "Technical Game Design Intern",
    period: "Jun–Sep 2026",
    location: "Shanghai",
    bullets: [
      "Established gameplay-data governance rules by auditing Gameplay Tag usage, dependencies, and ownership, then coordinating a project-wide migration from deprecated tags to typed enum fields.",
      "Defined and drove improvements to the designer-facing data pipeline, covering enum authoring, segmented IDs, parameter export, automatic table registration, versioning, and multi-branch support.",
      "Partnered with designers and engineers on runtime gameplay systems and character, camera, and controls (3C), including skill flows, interaction queries, handheld props, animation transitions, special-outfit support, and camera/control tuning.",
    ],
    tags: ["Technical Design", "Data Governance", "Design Tools", "Gameplay Systems"],
  },
  {
    company: "Tencent — Tiki Studio",
    role: "Game Design Intern",
    period: "2025",
    location: "Shenzhen",
    bullets: [
      "Independently developed and deployed a Python-based, AI-driven image-generation workflow to optimize internal art production for the Teamfight Tactics design and art teams.",
      "Used the toolchain to rapidly produce high-quality visual concept prototypes, drastically reducing iteration cost and bridging communication gaps between disciplines.",
      "Participated in the end-to-end design and engine implementation of top-tier (T0) commercial assets, ensuring design intent aligned with technical feasibility.",
    ],
    tags: ["Game Design", "AI Workflows", "Python", "Unity"],
  },
];
---

<BaseLayout title="Internships — Baohua Fang">
  <section class="container-wide pt-20 pb-24 max-w-4xl">
    <p class="eyebrow mb-6">Internships</p>
    <h1 class="display-lg mb-12">Where the work meets the world.</h1>

    <div class="space-y-16">
      {internships.map((it) => (
        <article class="rule pt-10">
          <div class="flex flex-wrap items-baseline justify-between gap-4 mb-6">
            <div>
              <h2 class="text-3xl font-[var(--font-display)]">{it.company}</h2>
              <p class="text-[color:var(--color-ink-dim)] mt-1">{it.role}</p>
            </div>
            <p class="text-sm text-[color:var(--color-ink-dim)]">
              {it.period} · {it.location}
            </p>
          </div>
          <ul class="space-y-3 text-[color:var(--color-ink-dim)] leading-relaxed list-disc list-outside ml-5">
            {it.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <div class="flex flex-wrap gap-2 mt-6">
            {it.tags.map((t) => <span class="chip">{t}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
