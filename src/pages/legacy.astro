---
import BaseLayout from "../layouts/BaseLayout.astro";

// Hand-picked literary works to feature. Replace links with real archive URLs
// once archive.hiddenblade.net is online.
const featured = [
  {
    title: "An Untypical Love Letter to MSX",
    kind: "Novella · 2020",
    excerpt:
      "My debut novella. The seed of nearly every narrative concern I now bring into game design.",
    href: "https://archive.hiddenblade.net/2020/01/24/anuntypicallovelettertomsx/",
  },
  {
    title: "Essays",
    kind: "Prose · 2018–2022",
    excerpt:
      "Short essays on memory, place, and the small embarrassments of being young.",
    href: "https://archive.hiddenblade.net/category/essays/",
  },
  {
    title: "Poetry",
    kind: "Verse · 2017–2021",
    excerpt:
      "Mostly first drafts. Mostly written at night. Kept here because they are evidence.",
    href: "https://archive.hiddenblade.net/category/poetry/",
  },
];
---

<BaseLayout title="Legacy — Baohua Fang">
  <section class="container-wide pt-20 pb-24 max-w-4xl">
    <p class="eyebrow mb-6">Legacy</p>
    <h1 class="display-lg mb-8">Before games, there were words.</h1>

    <div class="text-lg leading-relaxed text-[color:var(--color-ink-dim)] space-y-6">
      <p>
        I started writing in middle school — fiction, essays, poetry — and kept
        a literary blog called <span class="text-[color:var(--color-ink)]">hiddenblade.net</span>
        for nearly a decade. It was the first place I learned that a story is
        something built, not something found.
      </p>
      <p>
        Years later, after a particular game (<em>Death Stranding</em>) refused
        to leave me alone, I realized that text — for everything it can do —
        could not hold the kinds of expression I most wanted to attempt:
        the spatial, the interactive, the co-authored. So I crossed over.
      </p>
      <p>
        I do not write fiction the way I used to anymore. But the literary
        instinct — for cadence, for ambiguity, for the right small image at the
        right moment — is what I now route into systems. The archive below is
        the source code for that instinct.
      </p>
    </div>

    <div class="rule mt-16 pt-12">
      <p class="eyebrow mb-8">Selected writing</p>
      <div>
        {featured.map((f) => (
          <a
            href={f.href}
            target="_blank"
            rel="noreferrer"
            class="block py-7 border-t border-[color:var(--color-rule)] hover:border-[color:var(--color-accent)] transition-colors group"
          >
            <p class="eyebrow">{f.kind}</p>
            <h3 class="text-2xl font-[var(--font-display)] mt-2 group-hover:text-[color:var(--color-accent)] transition-colors">
              {f.title} <span class="text-[color:var(--color-ink-dim)]">↗</span>
            </h3>
            <p class="text-[color:var(--color-ink-dim)] mt-2">{f.excerpt}</p>
          </a>
        ))}
      </div>

      <div class="mt-12 py-8 border-y border-[color:var(--color-rule)]">
        <p class="eyebrow mb-3">Full archive</p>
        <p class="text-[color:var(--color-ink-dim)] mb-4">
          The complete literary archive (2017–2023) lives at its original home.
          It is frozen — no new posts — and preserved as-is.
        </p>
        <a
          href="https://archive.hiddenblade.net"
          target="_blank"
          rel="noreferrer"
          class="button-primary"
        >
          Visit archive.hiddenblade.net →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
