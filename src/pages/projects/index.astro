---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectGrid, { type ProjectMeta } from "../../components/ProjectGrid";

const all = (await getCollection("projects")).filter((p) => !p.data.hidden);
const sorted = all.sort((a, b) => a.data.order - b.data.order);

const meta: ProjectMeta[] = sorted.map((p) => ({
  slug: p.id,
  title: p.data.title,
  year: p.data.year,
  role: p.data.role,
  summary: p.data.summary,
  hook: p.data.hook,
  depth: p.data.depth,
  tags: p.data.tags,
  award: p.data.award,
  cover: p.data.cover,
  coverFit: p.data.coverFit,
  links: p.data.links,
}));
---

<BaseLayout title="Projects — Baohua Fang">
  <section class="container-wide pt-16 md:pt-24 pb-24">
    <p class="eyebrow mb-6">Project index · {meta.length} works</p>
    <h1 class="display-lg mb-6 max-w-4xl">
      What can a <span class="text-[color:var(--color-accent)]">game</span> be?
    </h1>
    <p class="text-[color:var(--color-ink-dim)] max-w-2xl mb-12">
      Filter by contribution. Case studies open as full project pages; smaller
      experiments retain a concise inline view.
    </p>

    <ProjectGrid client:load projects={meta} />
  </section>
</BaseLayout>
