---
const path = Astro.url.pathname;
const items = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Work" },
  { href: "/intern", label: "Experience" },
  { href: "/about", label: "About" },
  { href: "/legacy", label: "Writing" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-brand" aria-label="Baohua Fang — Home">
      <img src="/logo.png" alt="" class="site-brand__mark" />
      <span class="site-brand__copy">
        <strong>Baohua Fang</strong>
        <small>Technical game designer</small>
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      {items.map((it) => {
        const active = it.href === "/" ? path === "/" : path.startsWith(it.href);
        return (
          <a
            href={it.href}
            aria-current={active ? "page" : undefined}
            class:list={["site-nav__link", { active }]}
          >
            {it.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
