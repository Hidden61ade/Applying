---
import { getCollection } from "astro:content";

const path = Astro.url.pathname;
const projects = (await getCollection("projects"))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

const topLinks = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Selected work" },
  { href: "/about", label: "About" },
  { href: "/intern", label: "Experience" },
  { href: "/legacy", label: "Writing" },
];

const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="mobile-header md:hidden">
  <div class="mobile-header__top">
    <a href="/" class="mobile-brand" aria-label="Baohua Fang — Home">
      <img
        src="/logo-480.webp"
        srcset="/logo-480.webp 480w, /logo-1024.webp 1024w"
        sizes="40px"
        alt=""
        class="mobile-brand__mark"
      />
      <span>
        <strong>Baohua Fang</strong>
        <small>Game designer · Creative technologist</small>
      </span>
    </a>
  </div>
  <nav class="mobile-nav" aria-label="Primary navigation">
    {topLinks.map((it) => (
      <a
        href={it.href}
        aria-current={isActive(it.href) ? "page" : undefined}
        class:list={["mobile-nav__link", { active: isActive(it.href) }]}
      >
        {it.label}
      </a>
    ))}
  </nav>
</header>

<aside class="desktop-sidebar hidden md:flex" aria-label="Portfolio navigation">
  <div>
    <a href="/" class="sidebar-brand group" aria-label="Baohua Fang — Home">
      <img
        src="/logo-480.webp"
        srcset="/logo-480.webp 480w, /logo-1024.webp 1024w"
        sizes="72px"
        alt=""
        class="sidebar-brand__mark"
      />
      <span class="sidebar-brand__name">Baohua Fang</span>
      <span class="sidebar-brand__role">Game designer<br />Creative technologist</span>
    </a>

    <nav class="sidebar-nav" aria-label="Primary navigation">
      {topLinks.map((it, index) => (
        <a
          href={it.href}
          aria-current={isActive(it.href) ? "page" : undefined}
          class:list={["sidebar-nav__link", { active: isActive(it.href) }]}
        >
          <span class="sidebar-nav__index">0{index + 1}</span>
          <span>{it.label}</span>
        </a>
      ))}
    </nav>

    <div class="sidebar-projects">
      <p class="sidebar-label">Project index</p>
      <ul>
        {projects.map((p) => {
          const href = p.data.depth === "deep" ? `/projects/${p.id}` : "/projects";
          const active = path === `/projects/${p.id}`;
          return (
            <li>
              <a
                href={href}
                aria-current={active ? "page" : undefined}
                class:list={["sidebar-project-link", { active }]}
              >
                {p.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>

  <div class="sidebar-footer">
    <div class="sidebar-socials" aria-label="Social links">
      <a href="https://github.com/Hidden61ade">GitHub</a>
      <a href="https://hidden61ade.itch.io">itch.io</a>
    </div>
    <p>Shenzhen · GMT+8</p>
  </div>
</aside>
