---
import { getCollection } from "astro:content";

const path = Astro.url.pathname;
const projects = (await getCollection("projects"))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

const topLinks = [
  { href: "/about", label: "About" },
  { href: "/intern", label: "Intern" },
  { href: "/legacy", label: "Legacy" },
];

const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<aside
  class="md:fixed md:top-0 md:left-0 md:h-screen md:w-[240px] md:flex md:flex-col md:justify-between md:py-10 md:px-8 px-6 py-6 border-b md:border-b-0 md:border-r border-[color:var(--color-rule)]"
>
  <!-- Top: brand + links -->
  <div>
    <a href="/" class="block mb-10 group">
      <img
        src="/logo.png"
        alt="Hidden Blade"
        class="w-16 md:w-20 h-auto block mb-3 transition-opacity group-hover:opacity-70"
        style="filter: invert(1);"
      />
      <span class="font-[var(--font-display)] text-base tracking-tight leading-tight block">
        Baohua Fang
      </span>
      <span class="block text-[10px] uppercase tracking-[0.28em] text-[color:var(--color-ink-dim)] mt-1">
        Writer · Designer
      </span>
    </a>

    <nav class="flex md:flex-col gap-x-5 gap-y-2 text-sm">
      {topLinks.map((it) => (
        <a
          href={it.href}
          class:list={[
            "transition-colors",
            isActive(it.href)
              ? "text-[color:var(--color-accent)]"
              : "text-[color:var(--color-ink-dim)] hover:text-[color:var(--color-ink)]",
          ]}
        >
          {it.label}
        </a>
      ))}
    </nav>

    <div class="flex gap-3 mt-4 text-[color:var(--color-ink-dim)]">
      <a
        href="https://github.com/Hidden61ade"
        aria-label="GitHub"
        class="hover:text-[color:var(--color-ink)] transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.01-.02-1.99-3.2.7-3.87-1.54-3.87-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.07 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.6.23 2.77.11 3.07.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56 4.56-1.52 7.85-5.83 7.85-10.91C23.5 5.74 18.27.5 12 .5z"/>
        </svg>
      </a>
      <a
        href="https://hidden61ade.itch.io"
        aria-label="itch.io"
        class="hover:text-[color:var(--color-ink)] transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3.13 2.66C2.31 3.15.5 5.25.5 5.78v.9c0 1.13 1.06 2.13 2.02 2.13.95 0 1.74-.79 1.74-1.74 0 .95.78 1.74 1.74 1.74.95 0 1.7-.79 1.7-1.74 0 .95.83 1.74 1.78 1.74h.04c.95 0 1.78-.79 1.78-1.74 0 .95.75 1.74 1.7 1.74.96 0 1.74-.79 1.74-1.74 0 .95.79 1.74 1.74 1.74.96 0 2.02-1 2.02-2.13v-.9c0-.53-1.81-2.63-2.63-3.12C18.78 2.55 15.84 2.5 12 2.5s-6.78.05-8.87.16zM9.46 9.7c-.42.66-1.18 1.1-2.04 1.1-.74 0-1.4-.32-1.85-.83C5.12 10.5 4.46 10.8 3.74 10.8c-.13 0-.25-.02-.36-.04-.32 2.93-.5 7.16.5 8.17.85.85 4.97.97 8.12.99 3.16-.02 7.27-.14 8.12-.99 1-1.01.82-5.24.5-8.17-.11.02-.23.04-.36.04-.72 0-1.38-.3-1.83-.83-.45.51-1.11.83-1.85.83-.86 0-1.62-.44-2.04-1.1-.42.66-1.18 1.1-2.06 1.1h-.04c-.88 0-1.64-.44-2.06-1.1zm-1.9 3.13c.94.01 1.83.01 2.26.5h4.36c.43-.49 1.32-.49 2.26-.5.45 0 1.5 0 2.23.66.32.29.74 1.94.43 2.25-.4.39-1.27-.31-2.16-.31-.89 0-1.52.39-2.5.39-.66 0-1.45-.13-2.24-.4-.79.27-1.58.4-2.24.4-.98 0-1.61-.39-2.5-.39-.89 0-1.76.7-2.16.31-.31-.31.11-1.96.43-2.25.73-.66 1.78-.66 2.23-.66z"/>
        </svg>
      </a>
    </div>

    <div class="hidden md:block mt-10">
      <p class="text-[10px] uppercase tracking-[0.28em] text-[color:var(--color-ink-dim)] mb-3">
        Projects
      </p>
      <ul class="space-y-1.5 text-sm">
        {projects.map((p) => {
          const href = p.data.depth === "deep" ? `/projects/${p.id}` : "/projects";
          const active = path === `/projects/${p.id}`;
          return (
            <li>
              <a
                href={href}
                class:list={[
                  "transition-colors leading-snug block",
                  active
                    ? "text-[color:var(--color-accent)]"
                    : "text-[color:var(--color-ink-dim)] hover:text-[color:var(--color-ink)]",
                ]}
              >
                {p.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>

</aside>
